# FlowMate · 环境变量样例（复制为 .env 后填值；真实密钥绝不提交，也不出现在前端包与日志里）

# 监听与访问（PRD §21）
FLOWMATE_HOST=0.0.0.0
FLOWMATE_PORT=8080
FLOWMATE_DEV_PORT=5173
# 数据与文件存储位置（相对工程根目录，均已在 .gitignore 内）
FLOWMATE_DATA_DIR=data
FLOWMATE_STORAGE_DIR=storage

# 局域网 HTTP 的明文妥协（D6）：界面会常驻「局域网测试环境，勿放敏感数据」横幅
COOKIE_SECURE=false
FLOWMATE_LAN_BANNER=true
# 登录页是否显示「演示身份切换」（仅测试环境用；生产请设为 0）
FLOWMATE_DEMO=1

# 模型（标准 Chat Completions 接口，当前接 DeepSeek；密钥只在后端读取）
# 三项缺任意一项时，Agent 生成与纪要提取会明确返回 503 PROVIDER_UNAVAILABLE，FlowMate 不会伪造结果
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
# 视觉输入用的模型名（不填则沿用 MODEL_NAME）；首次使用会真实探测是否支持图片
MODEL_VISION_NAME=
MODEL_TIMEOUT_MS=120000
MODEL_MAX_RETRIES=1

# 共同确认节奏（PRD §11.3）
APPROVAL_REMIND_FIRST_HOURS=1
APPROVAL_REMIND_INTERVAL_HOURS=24
APPROVAL_SUSPEND_HOURS=72

# 执行槽与租约（PRD §11.4）
RUN_SLOTS_PER_SESSION=2
RUN_LEASE_SECONDS=60

# 上传批量上限（PRD §7.1）
BATCH_UPLOAD_MAX_FILES=20

# 备份用的签名链接密钥（留空则每次启动随机生成，已签发的下载链接会失效）
FLOWMATE_LINK_SECRET=

# 种子账号默认密码（README 会写明；改这里可同时改 seed 与登录）
SEED_PASSWORD=abc123
