{
  "name": "flowmate",
  "version": "2.5.0",
  "private": true,
  "description": "FlowMate · 面向任务协作的 AI 办公平台（v2.5 本地可运行）",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsc -p tsconfig.server.json -w & node --watch --enable-source-maps dist/server/main.js",
    "build": "npm run typecheck && tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/main.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit",
    "seed": "node dist/scripts/seed.js",
    "seed:reset": "node dist/scripts/seed.js --yes-reset",
    "backup": "node dist/scripts/backup.js",
    "restore": "node dist/scripts/backup.js --restore",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:probe": "node tests/agent-chat-probe.mjs",
    "test:render": "node node_modules/.pnpm/esbuild@0.25.12/node_modules/esbuild/bin/esbuild tests/agent-render-ssr.tsx --bundle --platform=node --format=esm --packages=external --loader:.css=empty --loader:.svg=dataurl --loader:.png=dataurl --outfile=.probe/ssr-agent-render.mjs && node .probe/ssr-agent-render.mjs",
    "test:build": "tsc -p tsconfig.server.json && tsc -p tsconfig.tests.json",
    "test:e2e": "node tests/e2e.mjs",
    "verify": "node scripts/verify-all.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "package": "node scripts/package-release.cjs",
    "package:src": "node scripts/package-release.cjs --src-only",
    "package:live": "node scripts/package-release.cjs --live-data",
    "demo-data": "mkdir -p .probe/demo-data .probe/demo-storage && FLOWMATE_DATA_DIR=.probe/demo-data FLOWMATE_STORAGE_DIR=.probe/demo-storage node dist/scripts/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.10",
    "@nestjs/core": "^11.0.10",
    "@nestjs/platform-express": "^11.0.10",
    "@nestjs/platform-ws": "^11.0.10",
    "@nestjs/websockets": "^11.0.10",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "diff": "^7.0.0",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.9.0",
    "marked": "^15.0.7",
    "multer": "^1.4.5-lts.1",
    "node-html-parser": "^7.0.1",
    "pdfjs-dist": "^4.10.38",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.18.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.67.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/diff": "^7.0.1",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "dompurify": "^3.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
